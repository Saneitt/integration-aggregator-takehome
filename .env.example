# Copy to .env (gitignored) and fill in locally. Never commit real values or paste them into chat.
# GitHub OAuth App: callback http://localhost:8080/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitLab application (scope read_user): redirect http://localhost:8080/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Google OAuth client (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your GitHub login, used by the demo script as the user id
DEMO_GITHUB_USER=