{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "serviceAccount", "openbao", "app", "service", "resources", "probes", "podSecurityContext", "securityContext", "networkPolicy", "test"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0, "maximum": 1},
    "image": {
      "type": "object", "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "serviceAccount": {"type": "object", "required": ["create", "name", "annotations"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object"}}},
    "openbao": {
      "type": "object", "required": ["address", "mount", "timeoutSeconds", "auth"],
      "properties": {
        "address": {"type": "string", "format": "uri"},
        "mount": {"type": "string", "pattern": "^[a-z][a-z0-9/-]*$"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "auth": {"type": "object", "required": ["method", "path", "role", "audience", "tokenExpirationSeconds"], "properties": {
          "method": {"type": "string", "enum": ["kubernetes", "token"]},
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "audience": {"type": "string", "minLength": 1},
          "tokenExpirationSeconds": {"type": "integer", "minimum": 600, "maximum": 3600},
          "tokenSecretName": {"type": "string"}
        }}
      }
    },
    "app": {"type": "object", "required": ["callbackUrl", "logLevel", "worker", "requestTtlSeconds", "stateTtlSeconds", "maxPendingStates"], "properties": {
      "callbackUrl": {"type": "string", "format": "uri"},
      "logLevel": {"type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
      "worker": {"type": "object", "required": ["concurrency", "queueMaxSize"], "properties": {"concurrency": {"type": "integer", "minimum": 1, "maximum": 128}, "queueMaxSize": {"type": "integer", "minimum": 1, "maximum": 10000}}},
      "requestTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
      "stateTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
      "maxPendingStates": {"type": "integer", "minimum": 1, "maximum": 100000}
    }},
    "service": {"type": "object", "required": ["type", "port"], "properties": {"type": {"type": "string", "enum": ["ClusterIP"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "resources": {"type": "object"},
    "probes": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "updateStrategy": {"type": "object", "properties": {"type": {"type": "string", "enum": ["Recreate"]}}},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "extraEnv": {"type": "array"},
    "networkPolicy": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "test": {"type": "object", "required": ["image"], "properties": {"image": {"type": "string", "minLength": 1}}}
  }
}
